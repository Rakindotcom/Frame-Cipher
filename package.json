{
  "name": "frame-cipher",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "next dev --webpack",
    "dev:turbo": "next dev",
    "build": "next build",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit --incremental false",
    "test": "node --test tests/*.test.mjs",
    "test:rules": "firebase emulators:exec --only firestore --project framecipherweb-rules-test \"node --test tests/rules/firestore-rules.test.mjs\"",
    "test:storage-rules": "firebase emulators:exec --only storage --project framecipherweb-rules-test \"node --test tests/rules/storage-rules.test.mjs\"",
    "emulators": "firebase emulators:start",
    "firebase:deploy:rules": "firebase deploy --only firestore:rules,firestore:indexes",
    "firebase:deploy:storage": "firebase deploy --only storage",
    "audit:routes": "node scripts/audit-routes.mjs",
    "start": "next start"
  },
  "dependencies": {
    "jspdf": "^4.2.1",
    "lucide-react": "^1.47.0",
    "next": "^16.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.1.18"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@netlify/plugin-nextjs": "^5.16.0",
    "@tailwindcss/postcss": "^4.2.4",
    "@types/node": "^26.6.2",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "firebase": "^12.19.0",
    "firebase-tools": "^15.31.0",
    "globals": "^16.5.0",
    "typescript": "^5.9.3"
  }
}
