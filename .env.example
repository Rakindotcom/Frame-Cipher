# Google Search Console API
# The property must match how the service account was added in Search Console.
# Domain property  -> sc-domain:framecipher.info
# URL-prefix       -> https://framecipher.info/
GSC_SITE_URL=sc-domain:framecipher.info
GSC_CLIENT_EMAIL=framecipher-gsc@framecipherweb.iam.gserviceaccount.com
# MUST be a single line. Copy private_key from the service account JSON and
# replace every real newline with the two characters \n, wrapped in double quotes.
GSC_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----"
# Minutes to shift "today" when deriving the date range (default 360 = Asia/Dhaka).
GSC_TZ_OFFSET_MINUTES=360

# Firebase
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# CMS image uploads use ImageKit. Set this private key in Netlify's Functions
# environment; never prefix it with NEXT_PUBLIC_ or commit it to Git.
IMAGEKIT_PRIVATE_KEY=

# ---------------------------------------------------------------------------
# Legacy server-side CMS API (not used by the admin dashboard)
# ---------------------------------------------------------------------------
# The dashboard writes directly with Firebase Authentication and Firestore.
# No Firebase Storage bucket or service account is needed for normal CMS use.
# Legacy server-side mutation endpoints remain for compatibility, but are not
# part of the dashboard flow. Do not configure a service account for the CMS.

# Administrator identity is defined in src/lib/admin/identity.ts and the same
# UID is present in firestore.rules. No separate session
# secret or ADMIN_FIREBASE_UID environment variable is required.
# Keep Email/Password enabled and disable Google under Authentication > Sign-in method.
# No signup page or signup helper exists in the website, but Firebase may still
# permit account creation through its public Auth API; other UIDs cannot access
# the dashboard or protected Firebase data.

# Site
NEXT_PUBLIC_SITE_URL=https://framecipher.info
