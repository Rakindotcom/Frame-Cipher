# Google Search Console API
# The property must match how the service account was added in Search Console.
# Domain property  -> sc-domain:framecipher.info
# URL-prefix       -> https://framecipher.info/
GSC_SITE_URL=sc-domain:framecipher.info
GSC_CLIENT_EMAIL=framecipher-gsc@framecipherweb.iam.gserviceaccount.com
# MUST be a single line. Copy private_key from the service account JSON and
# replace every real newline with the two characters \n, wrapped in double quotes.
GSC_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----"
# Minutes to shift "today" when deriving the date range (default 360 = Asia/Dhaka).
GSC_TZ_OFFSET_MINUTES=360

# Firebase
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# ---------------------------------------------------------------------------
# Server-side CMS persistence  (REQUIRED in production)
# ---------------------------------------------------------------------------
# The CMS writes blog posts, author profiles and media through the Firebase
# Admin SDK. Without these, a deployed build has no writable store: Netlify
# Functions run on a read-only per-invocation filesystem, so the previous
# `fs.writeFileSync` into src/data/*.json silently failed while the API still
# answered `{ success: true }`. The post was never stored and its URL 404'd.
#
# Supply the service account EITHER way:
#
#   A) Whole JSON, single line. Newlines may be literal or the two characters \n.
#      FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}
#
#   B) Split fields.
#      FIREBASE_SERVICE_ACCOUNT_EMAIL=
#      FIREBASE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----"
#
# The account needs the "Cloud Datastore User" role (firestore) and
# "Cloud Storage Admin" (storage).
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_SERVICE_ACCOUNT_EMAIL=
FIREBASE_SERVICE_ACCOUNT_PRIVATE_KEY=

# Administrator security  (REQUIRED - read by proxy.ts and every admin API route)
# Generate with:  openssl rand -hex 32
# Signs the HttpOnly admin session cookie. Must be at least 32 characters.
ADMIN_SESSION_SECRET=

# Comma-separated allowlist of emails permitted to reach /admin.
# If left EMPTY, any account that exists in Firebase Auth is allowed (still requires
# a real signed-in account, but it is not an allowlist). Set this in production.
# Example: ADMIN_EMAILS=you@framecipher.com
ADMIN_EMAILS=

# Optional role map, format email=role. Roles: owner | editor | author
# owner can do everything. Unlisted admins default to "editor".
# Example: ADMIN_ROLES=you@framecipher.com=owner
ADMIN_ROLES=

# Site
NEXT_PUBLIC_SITE_URL=https://framecipher.info
